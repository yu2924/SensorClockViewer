<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SensorClockViewer.AppMainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SensorClockViewer">
    <Grid RowDefinitions="Auto,*" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <TitleBar x:Name="AppTitleBar" Title="SensorClockViewer"/>
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        OpenPaneLength="144">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="LivePlotPage" Content="Live Plots">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="ArchivePage" Content="Archives">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="SettingsPage" Content="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
