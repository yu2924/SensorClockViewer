<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SensorClockViewer.Pages.LivePlotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SensorClockViewer.Pages"
    xmlns:scvpanels="using:SensorClockViewer.Panels"
    xmlns:scvcontrols="using:SensorClockViewer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <Grid Margin="16" RowDefinitions="*,Auto">
        <!-- plot lanes -->
        <scvcontrols:PlotArrayControl x:Name="PlotArrayCtrl" Grid.Row="0"/>
        <!-- operation panels -->
        <Expander Grid.Row="1" IsExpanded="True" ExpandDirection="Down" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <TextBlock Text="Operations" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
            </Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                <ListView x:Name="TabListView" SelectionChanged="TabListView_SelectionChanged">
                    <TextBlock Text="Edit" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="Archive" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </ListView>
                <scvpanels:LiveDbEditPanel x:Name="SensorEditPanel" Title="Sensor" PlotType="Sensor" ToneBrush="{ThemeResource SensorBrush}"/>
                <scvpanels:LiveDbEditPanel x:Name="WeatherEditPanel" Title="Weather" PlotType="Weather" ToneBrush="{ThemeResource WeatherBrush}"/>
                <scvpanels:LiveDbArchPanel x:Name="CreateArchPanel"/>
            </StackPanel>
        </Expander>
    </Grid>
</Page>
