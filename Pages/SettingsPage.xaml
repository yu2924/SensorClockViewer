<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SensorClockViewer.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="16" Spacing="4">
            <Expander IsExpanded="True" ExpandDirection="Down" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="Settings" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </Expander.Header>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="8" ColumnSpacing="8" RowSpacing="4" MaxWidth="480" HorizontalAlignment="Left">
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Text="Server" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Text="Host"/>
                    <TextBox Grid.Column="1" Grid.Row="1" PlaceholderText="e.g.: 192.168.1.10" Text="{x:Bind Settings.ServerName, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" Text="Port"/>
                    <NumberBox Grid.Column="1" Grid.Row="2" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline" SmallChange="1" Text="{x:Bind Settings.Port, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" Text="User Name"/>
                    <TextBox Grid.Column="1" Grid.Row="3" Text="{x:Bind Settings.UserName, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" Text="Password"/>
                    <PasswordBox Grid.Column="1" Grid.Row="4" Password="{x:Bind Settings.Password, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5" Text="Polling" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                    <TextBlock Grid.Column="0" Grid.Row="6" VerticalAlignment="Center" Text="Auto Fetch"/>
                    <ToggleSwitch Grid.Column="1" Grid.Row="6" OffContent="Inactive" OnContent="Active" IsOn="{x:Bind Settings.IsAutoFetchEnabled, Mode=TwoWay}" />
                    <TextBlock Grid.Column="0" Grid.Row="7" VerticalAlignment="Center" Text="Interval (sec.)"/>
                    <NumberBox Grid.Column="1" Grid.Row="7" Minimum="10" Maximum="86400" SpinButtonPlacementMode="Inline" SmallChange="10" Text="{x:Bind Settings.FetchIntervalSeconds, Mode=TwoWay}"/>
                </Grid>
            </Expander>
            <Expander IsExpanded="True" ExpandDirection="Down" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="About this application" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </Expander.Header>
                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="8" ColumnSpacing="8" RowSpacing="4">
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Text="{x:Bind AppName}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Version"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Bind AppVersion}"/>
                    <TextBlock Grid.Column="0" Grid.Row="2" Text="Developer"/>
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{x:Bind CompanyName}"/>
                    <TextBlock Grid.Column="0" Grid.Row="3" Text="Copyright"/>
                    <TextBlock Grid.Column="1" Grid.Row="3" Text="{x:Bind Copyright}"/>
                </Grid>
            </Expander>
            <Expander IsExpanded="True" ExpandDirection="Down" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="Third Party Software License Notices" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </Expander.Header>
                <StackPanel Orientation="Vertical" Margin="8" Spacing="8">
                    <TextBlock Text="This software includes the following licensed components:"/>
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Text="ScottPlot.WinUI" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Grid.Column="0" Grid.Row="1" Text="Version"/>
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="5.1.59"/>
                        <TextBlock Grid.Column="0" Grid.Row="2" Text="Author"/>
                        <TextBlock Grid.Column="1" Grid.Row="2" Text="Scott Harden"/>
                        <TextBlock Grid.Column="0" Grid.Row="3" Text="License"/>
                        <TextBlock Grid.Column="1" Grid.Row="3"><Span xml:space="preserve"><Hyperlink NavigateUri="https://licenses.nuget.org/MIT">MIT</Hyperlink></Span></TextBlock>
                        <TextBlock Grid.Column="0" Grid.Row="4" Text="Project URL"/>
                        <TextBlock Grid.Column="1" Grid.Row="4"><Span xml:space="preserve"><Hyperlink NavigateUri="https://scottplot.net/">https://scottplot.net/</Hyperlink></Span></TextBlock>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Text="Dapper" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Grid.Column="0" Grid.Row="1" Text="Version"/>
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="2.1.86"/>
                        <TextBlock Grid.Column="0" Grid.Row="2" Text="Author"/>
                        <TextBlock Grid.Column="1" Grid.Row="2" Text="Sam Saffron,Marc Gravell,Nick Craver"/>
                        <TextBlock Grid.Column="0" Grid.Row="3" Text="License"/>
                        <TextBlock Grid.Column="1" Grid.Row="3"><Span xml:space="preserve"><Hyperlink NavigateUri="https://licenses.nuget.org/Apache-2.0">Apache-2.0</Hyperlink></Span></TextBlock>
                        <TextBlock Grid.Column="0" Grid.Row="4" Text="Project URL"/>
                        <TextBlock Grid.Column="1" Grid.Row="4"><Span xml:space="preserve"><Hyperlink NavigateUri="https://dapperlib.dev/">https://dapperlib.dev/</Hyperlink></Span></TextBlock>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Text="Microsoft.Data.Sqlite" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Grid.Column="0" Grid.Row="1" Text="Version"/>
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="10.0.12"/>
                        <TextBlock Grid.Column="0" Grid.Row="2" Text="Author"/>
                        <TextBlock Grid.Column="1" Grid.Row="2" Text="Microsoft"/>
                        <TextBlock Grid.Column="0" Grid.Row="3" Text="License"/>
                        <TextBlock Grid.Column="1" Grid.Row="3"><Span xml:space="preserve"><Hyperlink NavigateUri="https://licenses.nuget.org/MIT">MIT</Hyperlink></Span></TextBlock>
                        <TextBlock Grid.Column="0" Grid.Row="4" Text="Project URL"/>
                        <TextBlock Grid.Column="1" Grid.Row="4"><Span xml:space="preserve"><Hyperlink NavigateUri="https://docs.microsoft.com/dotnet/standard/data/sqlite/">https://docs.microsoft.com/dotnet/standard/data/sqlite/</Hyperlink></Span></TextBlock>
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
