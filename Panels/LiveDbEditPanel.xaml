<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SensorClockViewer.Panels.LiveDbEditPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SensorClockViewer.Panels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel Orientation="Horizontal" Spacing="8" Padding="8" CornerRadius="8" Background="{x:Bind ToneBrush}">
        <!-- selection range -->
        <Grid RowDefinitions="Auto,*">
            <TextBlock x:Name="TitleTextBlock" Grid.Row="0" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Bottom" Spacing="4">
                <TextBox x:Name="SelFromTextBox" Header="From" VerticalAlignment="Bottom" Width="160" LostFocus="SelRangeTextBox_LostFocus" KeyDown="SelRangeTextBox_KeyDown"/>
                <TextBox x:Name="SelToTextBox" Header="To" VerticalAlignment="Bottom" Width="160" LostFocus="SelRangeTextBox_LostFocus" KeyDown="SelRangeTextBox_KeyDown"/>
            </StackPanel>
        </Grid>
        <!-- commands -->
        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="4">
            <RadioButtons x:Name="TargetRadio" Header="Target Range" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" SelectedIndex="1">
                <RadioButton Content="Selected Only"/>
                <RadioButton Content="Entire Data"/>
            </RadioButtons>
            <ProgressRing x:Name="BusyProgress" Grid.Column="1" Grid.Row="0"
                            Minimum="0" Maximum="1"
                            Value="{x:Bind TaskProgress, Mode=OneWay}"
                            IsIndeterminate="{x:Bind TaskIndeterminate, Mode=OneWay}"
                            IsActive="{x:Bind TargetTaskBusy, Mode=OneWay}"
                            Visibility="{x:Bind TargetTaskBusy, Converter={StaticResource ConvBoolToVisibility}, Mode=OneWay}"/>
            <Button  x:Name="FetchButton" Grid.Column="1" Grid.Row="0" Content="Fetch" Width="64"
                    Visibility="{x:Bind TargetTaskBusy, Converter={StaticResource ConvInvBoolToVisibility}, Mode=OneWay}"
                    Click="Fetch_Click"/>
            <Button x:Name="DeleteButton" Grid.Column="1" Grid.Row="1" Content="Delete" Width="64"
                    Visibility="{x:Bind TargetTaskBusy, Converter={StaticResource ConvInvBoolToVisibility}, Mode=OneWay}"
                    Click="Delete_Click"/>
            <Button x:Name="CancelButton" Grid.Column="1" Grid.Row="1" Content="Cancel" Width="64"
                    Visibility="{x:Bind TargetTaskBusy, Converter={StaticResource ConvBoolToVisibility}, Mode=OneWay}"
                    Click="Cancel_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="None" Key="Escape"/>
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
