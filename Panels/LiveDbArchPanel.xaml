<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SensorClockViewer.Panels.LiveDbArchPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SensorClockViewer.Panels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel Orientation="Horizontal" Spacing="8" Padding="8" CornerRadius="8" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
        <!-- selection range -->
        <StackPanel Orientation="Vertical">
            <CheckBox x:Name="UseRangeCheck" Content="Archive from selection range" Click="UseRange_Click"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBox x:Name="SelFromTextBox" Header="From" Width="160" VerticalAlignment="Bottom" LostFocus="SelRangeTextBox_LostFocus" KeyDown="SelRangeTextBox_KeyDown"/>
                <TextBox x:Name="SelToTextBox" Header="To" Width="160" VerticalAlignment="Bottom" LostFocus="SelRangeTextBox_LostFocus" KeyDown="SelRangeTextBox_KeyDown"/>
            </StackPanel>
        </StackPanel>
        <!-- commands -->
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="auto,*" VerticalAlignment="Stretch">
            <CheckBox x:Name="RemoveRangeCheck" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Content="Remove the range after completion"/>
            <ProgressRing Grid.Column="0" Grid.Row="1"  HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True" IsActive="{x:Bind TargetTaskBusy, Mode=OneWay}"/>
            <Button x:Name="CreateButton" Grid.Column="1" Grid.Row="1" Content="Create" Width="64" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Visibility="{x:Bind TargetTaskBusy, Converter={StaticResource ConvInvBoolToVisibility}, Mode=OneWay}"
                    Click="ArchiveCreate_Click"/>
            <Button Grid.Column="1" Grid.Row="1" Content="Cancel" Width="64" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Visibility="{x:Bind TargetTaskBusy, Converter={StaticResource ConvBoolToVisibility}, Mode=OneWay}"
                        Click="Cancel_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="None" Key="Escape"/>
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
